PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Central ResearchPulse SSO
# The API URL is used for server-to-server calls. In Docker it can be an
# internal network alias while the issuer remains the browser-facing URL.
CENTRAL_SSO_API_URL=http://localhost:3001
CENTRAL_SSO_ISSUER_URL=http://localhost:3001
CENTRAL_SSO_TIMEOUT_MS=5000
SSO_CLIENT_ID=demo-client-app
SSO_REDIRECT_URI=http://localhost:5173/auth/callback

# Child-session signing secrets
VN_JWT_SECRET=replace-with-a-secret
VN_JWT_REFRESH_SECRET=replace-with-a-secret
# Optional: only needed when cleaning up old parent-cookie sessions
VN_SSO_BLOCK_SECRET=replace-with-a-secret
